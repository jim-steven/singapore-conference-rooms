                                        <option value="Building History">Building History</option>
                                      
                                        <option value="Research, Publications, Archives and Collections">Research, Publications, Archives and Collections</option>
                                      
                                        <option value="Families and Kids">Families and Kids</option>
                                      
                                        <option value="Events, Programmes and Tours">Events, Programmes and Tours</option>
                                      </slimselect>

