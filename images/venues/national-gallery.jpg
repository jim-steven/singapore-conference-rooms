                      		</div>
                      	</div>
                        <form @submit.prevent="submitForm" novalidate action="/content/experience-fragments/nationalgallerysg/sg/en/site/footer/master/_jcr_content/root/footer.ngs.json" data-redirect="/sg/en/subscribe/thank-you.html" data-redirect-error="/sg/en/subscribe/error.html" id="newsletterSubscription">
                          <div class="row">
