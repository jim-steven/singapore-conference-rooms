    <div class="freehtml aem-GridColumn aem-GridColumn--default--12"><style type = "text/css">

        .section-404 {
          overflow: hidden;
        }
        @media (min-width: 1024px) {
          .section-404 .row {
            --row-gutter: 96px;
          }
        }
        @media (min-width: 768px) and (max-width: 1023px) {
          .section-404 .row {
            --row-gutter: 48px;
          }
        }
        .section-404:not([data-grid-area]) .row {
          row-gap: 32px;
        }
        @media (min-width: 768px) {
          .col-404--main,
          .col-404--links {
            padding-top: clamp(2rem, 0.0055720654rem + 4.1604754829vw, 3.75rem);
            padding-bottom: clamp(2rem, 0.0055720654rem + 4.1604754829vw, 3.75rem);
          }
        }
        @media (min-width: 768px) {
          .col-404--main {
            display: flex;
            align-self: center;
            justify-content: flex-end;
          }
        }
        .col-404--main-wrp {
          text-align: center;
        }
        @media (min-width: 1440px) {
          .col-404--main-wrp {
            padding-right: 12px;
          }
        }
        @media (max-width: 767px) {
          .col-404--main-wrp {
            padding-right: 20px;
            padding-left: 20px;
          }
        }
        .col-404--main .svg-wrp {
          font-size: 0;
        }
        .col-404--main svg {
          max-width: 100%;
          width: 434px;
          height: auto;
          display: inline-block;
        }
        .col-404--main .h4 {
          font-size: clamp(1.375rem, 0.8125rem + 1.875vw, 2.5rem);
          font-weight: 800;
          line-height: 1.2;
        }
        @media (max-width: 767px) {
          .col-404--main .h4 {
            margin-bottom: 0;
          }
        }
        .col-404--links {
          position: relative;
        }
        .col-404--links::before,
        .col-404--links::after {
          content: '';
          position: absolute;
          pointer-events: none;
        }
        .col-404--links::before {
          width: calc(100% + 20px);
          height: 1px;
          background-color: var(--color-brand-red);
          top: 0;
          right: 100%;
        }
        .col-404--links::after {
          width: calc(100% - 48px);
          height: 100%;
          border-left: 1px solid var(--color-brand-red);
          border-bottom: 1px solid var(--color-brand-red);
          top: 0;
          left: 0;
        }
        @media (min-width: 1024px) {
          .col-404--links-wrp {
            padding-right: 16.66667%;
          }
        }
        @media (min-width: 1440px) {
          .col-404--links-wrp {
            padding-right: 33.33333%;
            padding-left: 24px;
          }
        }
        @media (max-width: 767px) {
          .col-404--links::before {
            width: calc(100% - 10px);
            right: auto;
            left: 5px;
          }
          .col-404--links::after {
            border-bottom: 0 none;
            left: 5px;
          }
          .col-404--links-wrp {
            padding: 20px;
          }
        }
        .col-404--links .h6 {
          font-size: clamp(1.125rem, 1rem + 0.4166666667vw, 1.375rem);
        }
        @media (min-width: 768px) {
          .col-404--links .btn {
            position: absolute;
            right: calc(var(--row-gutter) / 2);
            bottom: -42px;
            z-index: 1;
          }
        }
      </style></div>
