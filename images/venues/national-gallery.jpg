                                    <div class="input-group" :class="{'is-invalid':errors.includes('firstName'), 'is-invalid-pattern' : patternErrors.includes('firstName')}">
                                      <label class="input-label" for="firstName">First Name*</label>
                                      <input class="input" pattern="^[a-zA-Z0-9@\- ]+$" v-model="formData.firstName" @focus="removeError($event.target.name)" type="text" placeholder="John" name="firstName" required @blur="checkInvalidPattern"/>
                                      <small class="input-invalid">Please key in your first name.</small>
                                      <small class="input-invalid-pattern">Only letters, numbers,@, and - are allowed.</small>
                                      </div>
                                  </div>
                                  <div class="col-4 col-12-sm">
                                    <div class="input-group" :class="{'is-invalid':errors.includes('lastName'), 'is-invalid-pattern' : patternErrors.includes('lastName')}">
                                      <label class="input-label" for="lastName">Last Name*</label>
                                      <input class="input" @blur="checkInvalidPattern" pattern="^[a-zA-Z0-9@\- ]+$" v-model="formData.lastName" @focus="removeError($event.target.name)" type="text" placeholder="Tan" name="lastName" required/>
                                      <small class="error">Please key in your last name.</small>
                                      <small class="input-invalid-pattern">Only letters, numbers, @, and - are allowed.</small>
                                    </div>
                                  </div>
                                  <div class="col-4 col-12-sm">
                                    <div class="input-group" :class="{'is-invalid':errors.includes('emailAddress'), 'is-invalid-pattern' : isInvalidEmail}">
                                      <label class="input-label" for="emailAddress">Email address*</label>
                                      <input class="input" v-model="formData.emailAddress" @blur="checkInvalidEmail" @focus="removeError($event.target.name)" type="email" placeholder="E.g., johntan@gmail.com" name="emailAddress" required/>
                                      <small class="input-invalid">This field is required.</small>
                                      <small class="input-invalid-pattern">Please enter a valid email address.</small>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <div class="group-tours__form-section">
                                <div class="row">
                                  <div class="col-12">
                                    <div class="input-group" :class="{'is-invalid':errors.includes('audienceType')}">
                                      <label class="input-label" for="audienceType">
                                        <p>Let us know what you are interested in*</p>
                                        <p class="text-body">Select up to 5 interests</p>
                                      </label>

                                      <slimselect class="select-slim" v-model="formData.audienceType" required name="audienceType" multiple placeholder="Please select one" :settings="{ showSearch: false }">
